# ==============================================================================
# CASELINK Environment Configuration
# ==============================================================================

# Database Connection
# SQLite (Local/Demo default): sqlite:///./caselink.db
# PostgreSQL (Production): postgresql://caselink_user:password@localhost:5432/caselink_db
DATABASE_URL=sqlite:///./caselink.db

# JWT Authentication
SECRET_KEY=caselink-dev-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Uploads directory
UPLOAD_DIR=uploads

# Optional frontend dist path (if running fullstack container)
# FRONTEND_DIST_DIR=../frontend/dist
